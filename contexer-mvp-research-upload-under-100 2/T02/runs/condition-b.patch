 """Report output functions for the T02 fixture."""
+
+import os
+import tempfile
+from pathlib import Path
 
 
 def write_report(path, content: str) -> None:
-    """Write generated report content to the destination path."""
-    raise NotImplementedError("Implement T02")
+    """Atomically replace the destination with generated report content."""
+    destination = Path(path)
+    temporary_path = None
+    try:
+        with tempfile.NamedTemporaryFile(
+            mode="w",
+            encoding="utf-8",
+            dir=destination.parent,
+            delete=False,
+        ) as temporary_file:
+            temporary_path = Path(temporary_file.name)
+            temporary_file.write(content)
+
+        os.replace(temporary_path, destination)
+    finally:
+        if temporary_path is not None:
+            temporary_path.unlink(missing_ok=True)
